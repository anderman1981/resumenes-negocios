# ==========================================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copia este archivo como ".env" para desarrollo local:  cp .env.example .env
#  ⚠️ El archivo ".env" NO se sube a git (está en .gitignore). Nunca pongas
#     claves reales en el código ni en .env.example.
#
#  EN PRODUCCIÓN estas variables NO se leen de aquí: se configuran en
#  Vercel → tu proyecto → Settings → Environment Variables.
# ==========================================================================

# --- Simulador de ventas (Groq, modelos gratis) ---
# Obtén tu clave en https://console.groq.com/keys
GROQ_API_KEY=pon_aqui_tu_clave_de_groq

# (Opcional) Cascada de modelos; si uno se queda sin cupo, salta al siguiente.
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,gemma2-9b-it

# --- Comentarios (Vercel Blob) ---
# BLOB_READ_WRITE_TOKEN lo crea Vercel automáticamente al conectar un store Blob
# (Storage → Create Database → Blob). En LOCAL, pégalo aquí si quieres probar con `vercel dev`.
BLOB_READ_WRITE_TOKEN=

# Clave secreta que TÚ inventas para poder descargar el comentarios.json
COMENTARIOS_TOKEN=inventa_una_clave_secreta
