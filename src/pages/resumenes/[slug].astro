---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import Multimedia from '../../components/Multimedia.astro';
import SeriePanel from '../../components/SeriePanel.astro';
import Comentarios from '../../components/Comentarios.astro';
import { getPublicados } from '../../lib/content.mjs';
import { SITE, CATEGORIAS } from '../../config.mjs';

export async function getStaticPaths() {
  const entries = await getPublicados();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const cat = CATEGORIAS.find((c) => c.slug === data.categoria);

// Schema.org para SEO enriquecido en Google
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titulo,
  description: data.descripcion,
  datePublished: data.fecha.toISOString(),
  dateModified: (data.actualizado ?? data.fecha).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.name },
  about: { '@type': 'Book', name: data.libro, author: data.autor },
};
---

<BaseLayout title={data.titulo} description={data.descripcion} article={true} publishedTime={data.fecha}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[1fr_320px]">
    <article>
      <nav class="mb-6 text-sm text-slate-400">
        <a href="/" class="hover:text-brand-600">Inicio</a>
        <span class="mx-1">/</span>
        {cat && <><a href={`/categorias/${cat.slug}`} class="hover:text-brand-600">{cat.nombre}</a><span class="mx-1">/</span></>}
        <span class="text-slate-600">{data.titulo}</span>
      </nav>

      <header>
        {data.serie && data.dia && (
          <a href={`/curso/${data.serie}`} class="inline-block rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">
            Día {data.dia} · {data.serieNombre}
          </a>
        )}
        {cat && (
          <a href={`/categorias/${cat.slug}`} class="ml-2 inline-block rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold text-brand-700">
            {cat.nombre}
          </a>
        )}
        <h1 class="mt-4 text-4xl font-extrabold leading-tight tracking-tight text-slate-900">{data.titulo}</h1>
        <p class="mt-3 text-lg text-slate-600">
          Resumen de <strong class="text-slate-800">{data.libro}</strong>, de {data.autor}
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-400">
          <span>⏱ {data.minutosLectura} min de lectura</span>
          <span>·</span>
          <span>{data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        </div>
      </header>

      <Multimedia youtube={data.youtube} audio={data.audio} titulo={data.titulo} />

      {data.pdf && (
        <div class="mt-8 flex flex-wrap items-center gap-3 rounded-2xl border border-brand-100 bg-brand-50/60 p-5">
          <span class="text-sm font-semibold text-slate-700">📄 Material descargable</span>
          <a href={data.pdf} download class="inline-block rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white no-underline transition hover:bg-brand-700">
            {data.pdfNombre || 'Descargar PDF'}
          </a>
        </div>
      )}

      {data.ideasClave.length > 0 && (
        <div class="mt-8 rounded-2xl border border-brand-100 bg-brand-50/60 p-6">
          <h2 class="text-sm font-bold uppercase tracking-wide text-brand-700">Ideas clave</h2>
          <ul class="mt-3 space-y-2">
            {data.ideasClave.map((idea) => (
              <li class="flex gap-2 text-slate-700">
                <span class="mt-1 text-brand-600">✦</span>
                <span>{idea}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <AdSlot slot="inArticle" />

      <div class="prose prose-lg prose-slate mt-8 max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-h2:mt-10 prose-h2:text-2xl prose-h3:mt-8 prose-h3:text-xl prose-p:leading-relaxed prose-a:text-brand-600 prose-strong:text-slate-900 prose-li:my-1 prose-table:text-base">
        <Content />
      </div>

      <AdSlot slot="footer" />

      <div class="mt-10 rounded-2xl bg-slate-50 p-6 text-sm text-slate-500">
        <p>
          Este es un <strong>análisis original y resumido</strong> con fines educativos e informativos.
          No reproduce el material original. Si el contenido te resultó útil, considera acceder a la
          obra original para apoyar a su autor.
        </p>
      </div>

      <Comentarios slug={entry.slug} />
    </article>

    <div class="lg:sticky lg:top-20 lg:self-start">
      {data.serie && <SeriePanel serie={data.serie} actual={entry.slug} />}
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
