---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import CompartirSerie from '../../components/CompartirSerie.astro';
import { getSeries, getSerie } from '../../lib/content.mjs';
import { SITE } from '../../config.mjs';

export async function getStaticPaths() {
  const series = await getSeries();
  const paths = [];
  for (const s of series) {
    paths.push({ params: { serie: s.slug }, props: { serie: s } });
  }
  return paths;
}

const { serie } = Astro.props;
const modulos = await getSerie(serie.slug);
// Total dinámico: no asume 7 días (soporta series de otra longitud)
const total = Math.max(
  modulos.length,
  ...modulos.map((m) => m.entry.data.dia ?? 0),
);
const disponibles = modulos.filter((m) => m.disponible).length;
const completado = disponibles >= total;

const currentUrl = `${SITE.url}/curso/${serie.slug}`;
const descripcionCorta = serie.descripcion || `Serie de ${total} días: ${serie.nombre}. Un módulo nuevo cada día.`;
---

<BaseLayout 
  title={serie.nombre} 
  description={descripcionCorta}
  image={serie.portada}
>
  <section class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white py-12 md:py-16">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid gap-8 md:grid-cols-12 md:items-center">
        
        {/* Imagen de Intro de la Serie */}
        {serie.portada && (
          <div class="md:col-span-5 lg:col-span-4 flex justify-center">
            <div class="relative overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-xl transition-transform duration-300 hover:scale-[1.01]">
              <img 
                src={serie.portada} 
                alt={`Portada ${serie.nombre}`} 
                class="w-full max-w-[280px] sm:max-w-[320px] md:max-w-full h-auto object-cover rounded-2xl" 
                loading="eager"
              />
            </div>
          </div>
        )}

        {/* Información, Resumen corto, Enlace de Material y Redes */}
        <div class={`space-y-4 ${serie.portada ? 'md:col-span-7 lg:col-span-8 text-center md:text-left' : 'md:col-span-12 text-center max-w-3xl mx-auto'}`}>
          <div class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-3.5 py-1 text-xs sm:text-sm font-semibold text-white">
            <span>Serie de {total} días</span>
            <span>·</span>
            <span class="text-brand-300">{disponibles} disponibles</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight text-slate-900">
            {serie.nombre}
          </h1>

          {/* Resumen corto (No oculta la imagen) */}
          <p class="text-base sm:text-lg leading-relaxed text-slate-600 max-w-2xl">
            {descripcionCorta}
          </p>

          {/* Enlaces de Descarga de Materiales / PDF (Condicionado a finalización) */}
          <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-3">
            {completado ? (
              serie.pdf && (
                <a
                  href={serie.pdf}
                  download
                  class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 hover:shadow-md"
                >
                  <span>📄</span>
                  <span>{serie.pdfNombre || 'Descargar guía completa (PDF)'}</span>
                </a>
              )
            ) : (
              <>
                {serie.pdf && (
                  <div 
                    class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-100/90 px-4 py-2.5 text-xs sm:text-sm font-semibold text-slate-500 shadow-inner"
                    title={`La guía completa se habilitará al publicar el Día ${total}`}
                  >
                    <span>🔒</span>
                    <span>Guía completa (Disponible el Día {total})</span>
                  </div>
                )}
                {serie.infografia && (
                  <a
                    href={serie.infografia}
                    download
                    class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 hover:shadow-md"
                  >
                    <span>📊</span>
                    <span>{serie.infografiaNombre || 'Descargar infografía (PDF)'}</span>
                  </a>
                )}
              </>
            )}
          </div>

          {/* Bloque para compartir en redes sociales */}
          <CompartirSerie
            nombre={serie.nombre}
            descripcion={descripcionCorta}
            url={currentUrl}
            portada={serie.portada}
            pdf={serie.pdf}
            pdfNombre={serie.pdfNombre}
          />
        </div>

      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12">
    <h2 class="mb-6 text-xl font-bold text-slate-900">Módulos de la serie</h2>

    <ol class="space-y-4">
      {modulos.map(({ entry, disponible }) => (
        disponible ? (
          <li>
            <a href={`/resumenes/${entry.slug}`} class="group flex items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-brand-300 hover:shadow-md">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-600 text-sm font-bold text-white">
                {entry.data.dia}
              </span>
              <div>
                <h2 class="font-bold text-slate-900 group-hover:text-brand-600">{entry.data.titulo}</h2>
                <p class="mt-1 text-sm text-slate-500">{entry.data.descripcion}</p>
              </div>
            </a>
          </li>
        ) : (
          <li>
            <div class="flex items-start gap-4 rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-slate-200 text-sm font-bold text-slate-500">
                {entry.data.dia}
              </span>
              <div>
                <h2 class="font-bold text-slate-400">{entry.data.titulo}</h2>
                <p class="mt-1 text-sm text-slate-400">
                  🔒 Disponible el {entry.data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </p>
              </div>
            </div>
          </li>
        )
      ))}
      {Array.from({ length: Math.max(0, total - modulos.length) }).map((_, i) => (
        <li>
          <div class="flex items-center gap-4 rounded-2xl border border-dashed border-slate-200 p-5 text-slate-300">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-slate-100 text-sm font-bold">
              {modulos.length + i + 1}
            </span>
            <span class="text-sm font-medium">Próximamente…</span>
          </div>
        </li>
      ))}
    </ol>

    <AdSlot slot="footer" />
  </section>
</BaseLayout>
