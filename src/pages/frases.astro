---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config.mjs';

// Frases de alto impacto para WhatsApp / Instagram, cada una enlazada a su módulo.
const frases = [
  {
    emoji: '💡',
    texto: 'Vender no es manipular ni presionar; es la responsabilidad moral de transferir certeza a través de un puente de confianza.',
    cta: 'Aprende a vender con lógica',
    slug: 'la-arquitectura-de-la-decision',
  },
  {
    emoji: '🧠',
    texto: 'La emoción te hace dar el primer paso, pero la lógica es el cimiento que evita el arrepentimiento del comprador.',
    cta: 'Domina la venta racional',
    slug: 'la-arquitectura-de-la-decision',
  },
  {
    emoji: '⏳',
    texto: 'Esperar "al momento perfecto" es una ilusión. El mejor momento para construir un nuevo hábito es cuando estás más ocupado.',
    cta: 'Deja de postergar tus decisiones',
    slug: 'desarmar-barreras-tiempo-dinero',
  },
  {
    emoji: '💰',
    texto: 'El costo siempre se paga: o lo pagas con dinero hoy, o lo pagas con años de tiempo y frustración en el futuro.',
    cta: 'Conoce la metodología',
    slug: 'desarmar-barreras-tiempo-dinero',
  },
  {
    emoji: '🎯',
    texto: 'Las decisiones no requieren más tiempo; requieren más información. Pensarlo sin nueva información solo es procrastinar.',
    cta: 'Resuelve tus dudas hoy',
    slug: 'neutralizar-el-necesito-pensarlo',
  },
  {
    emoji: '🔥',
    texto: 'No dejes que una mala decisión previa te queme dos veces impidiéndote tomar una buena decisión hoy.',
    cta: 'Cambia tu perspectiva',
    slug: 'neutralizar-el-necesito-pensarlo',
  },
  {
    emoji: '🚀',
    texto: 'Nuevos resultados exigen una nueva identidad. Indecidirse es la decisión activa de matar el futuro que deseas.',
    cta: 'Da el primer paso',
    slug: 'reencuadrar-ajuste-y-autoridad',
  },
  {
    emoji: '✈️',
    texto: 'No le vendas a tu cliente el vuelo ni la lista de módulos; véndele las vacaciones y la transformación en el destino.',
    cta: 'Ve cómo podemos ayudarte',
    slug: 'el-marco-closer',
  },
];
---

<BaseLayout title="Frases para compartir" description="Frases de alto impacto sobre ventas para compartir en WhatsApp e Instagram, con enlace a cada lección.">
  <section class="border-b border-slate-100 bg-gradient-to-b from-slate-50 to-white">
    <div class="mx-auto max-w-4xl px-4 py-14 text-center">
      <span class="inline-block rounded-full bg-brand-100 px-3 py-1 text-sm font-semibold text-brand-700">Recursos para compartir</span>
      <h1 class="mx-auto mt-4 max-w-2xl text-4xl font-extrabold tracking-tight text-slate-900">
        Frases de alto impacto para tus estados
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-lg text-slate-600">
        Copia, pega en tu estado de WhatsApp o historia de Instagram, y añade el enlace.
        Cada frase lleva a su lección.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="grid gap-6 sm:grid-cols-2">
      {frases.map((f) => {
        const url = `${SITE.url}/resumenes/${f.slug}`;
        const textoCompleto = `${f.emoji} "${f.texto}"\n\n📲 ${f.cta}: ${url}`;
        return (
          <div class="flex flex-col rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <p class="text-lg font-medium leading-snug text-slate-800">
              <span class="mr-1">{f.emoji}</span>{f.texto}
            </p>
            <p class="mt-3 text-sm font-semibold text-brand-600">📲 {f.cta}</p>
            <div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
              <button
                data-copiar={textoCompleto}
                class="copiar-btn rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700"
              >
                Copiar frase + enlace
              </button>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(textoCompleto)}`}
                target="_blank"
                rel="noopener"
                class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                Compartir en WhatsApp
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <div class="mt-10 rounded-2xl bg-slate-50 p-6 text-sm text-slate-500">
      <p class="font-semibold text-slate-700">Cómo usarlas</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Pulsa "Copiar frase + enlace" (ya incluye la URL de la lección).</li>
        <li>Pega en tu estado de WhatsApp o historia de Instagram, sobre una imagen atractiva.</li>
        <li>En WhatsApp puedes usar el sticker de enlace; en Instagram, el sticker de link.</li>
      </ol>
    </div>

    <AdSlot slot="footer" />
  </section>

  <script>
    document.querySelectorAll('.copiar-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const texto = btn.getAttribute('data-copiar') || '';
        try {
          await navigator.clipboard.writeText(texto);
          const original = btn.textContent;
          btn.textContent = '✓ ¡Copiado!';
          setTimeout(() => { btn.textContent = original; }, 1800);
        } catch (e) {
          alert('Copia manual:\n\n' + texto);
        }
      });
    });
  </script>
</BaseLayout>
