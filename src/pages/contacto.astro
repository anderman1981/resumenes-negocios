---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config.mjs';
---

<BaseLayout title="Contacto" description={`Contacta con ${SITE.name}.`}>
  <section class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-extrabold text-slate-900">Contacto</h1>
    <p class="mt-3 text-slate-600">
      ¿Tienes una duda, sugerencia o quieres proponer un libro para resumir? Escríbenos y te respondemos.
    </p>

    <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
      <p class="text-sm font-semibold text-slate-500">Correo electrónico</p>
      <a href={`mailto:${SITE.email}`} class="mt-1 block text-lg font-bold text-brand-600 hover:underline">
        {SITE.email}
      </a>
      <p class="mt-4 text-sm text-slate-500">
        Responsable: {SITE.author}. Normalmente respondemos en un plazo de 48–72 horas.
      </p>
    </div>

    <div class="mt-6 text-sm text-slate-500">
      <p>
        Para asuntos de privacidad o de datos, consulta nuestra
        <a href="/privacidad" class="text-brand-600 hover:underline">Política de Privacidad</a>.
      </p>
    </div>
  </section>
</BaseLayout>
