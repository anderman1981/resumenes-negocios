---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="text-7xl font-extrabold text-brand-600">404</p>
    <h1 class="mt-4 text-3xl font-extrabold text-slate-900">Página no encontrada</h1>
    <p class="mt-3 text-slate-600">
      La página que buscas no existe o fue movida. Vuelve al inicio o explora los resúmenes.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white transition hover:bg-brand-700">Ir al inicio</a>
      <a href="/resumenes" class="rounded-xl border border-slate-200 px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50">Ver resúmenes</a>
    </div>
  </section>
</BaseLayout>
