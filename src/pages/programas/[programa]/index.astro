---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProgramas, getPrograma } from '../../../lib/programas.mjs';

export async function getStaticPaths() {
  const programas = await getProgramas();
  return programas.map((p) => ({
    params: { programa: p.slug },
    props: { programa: p },
  }));
}

const { programa: pProps } = Astro.props;
// Recargar data fresca
const programa = await getPrograma(pProps.slug) || pProps;
---

<BaseLayout
  title={`${programa.nombre} — Serie Multimodal 7 Días (+ Día 0)`}
  description={programa.descripcion}
  image={programa.portada}
>
  <!-- Program Header / Hero -->
  <section class="border-b border-slate-100 bg-gradient-to-b from-slate-900 to-slate-950 py-12 md:py-16 text-white">
    <div class="mx-auto max-w-5xl px-4">
      <div class="grid gap-8 md:grid-cols-12 md:items-center">
        {programa.portada && (
          <div class="md:col-span-5 flex justify-center">
            <div class="relative overflow-hidden rounded-2xl border border-slate-700 bg-slate-800 shadow-2xl">
              <img
                src={programa.portada}
                alt={programa.nombre}
                class="w-full max-w-[320px] md:max-w-full h-auto object-cover rounded-2xl"
                loading="eager"
              />
            </div>
          </div>
        )}

        <div class={`space-y-4 ${programa.portada ? 'md:col-span-7' : 'md:col-span-12 text-center max-w-3xl mx-auto'}`}>
          <div class="inline-flex items-center gap-2 rounded-full bg-brand-500/20 px-3.5 py-1 text-xs sm:text-sm font-semibold text-brand-300 border border-brand-500/30">
            <span>Programa Ejecutivo</span>
            <span>·</span>
            <span>{programa.dias.length} Módulos</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold leading-tight tracking-tight text-white">
            {programa.nombre}
          </h1>

          <p class="text-sm font-semibold text-slate-300">
            Metodología por <span class="text-white">{programa.autor}</span>
          </p>

          <p class="text-base sm:text-lg leading-relaxed text-slate-300">
            {programa.descripcion}
          </p>

          <!-- Multimedia Features Pills -->
          <div class="pt-2 flex flex-wrap gap-2 text-xs">
            <span class="rounded-lg bg-slate-800/90 border border-slate-700 px-3 py-1.5 text-slate-300 flex items-center gap-1.5">
              🎙️ 8 Audio Podcasts
            </span>
            <span class="rounded-lg bg-slate-800/90 border border-slate-700 px-3 py-1.5 text-slate-300 flex items-center gap-1.5">
              📊 Slides en PDF
            </span>
            <span class="rounded-lg bg-slate-800/90 border border-slate-700 px-3 py-1.5 text-slate-300 flex items-center gap-1.5">
              📑 Workbooks Descargables
            </span>
            <span class="rounded-lg bg-slate-800/90 border border-slate-700 px-3 py-1.5 text-slate-300 flex items-center gap-1.5">
              🎴 Flashcards Mnemotécnicas
            </span>
            <span class="rounded-lg bg-slate-800/90 border border-slate-700 px-3 py-1.5 text-slate-300 flex items-center gap-1.5">
              📝 Quizzes Evaluativos
            </span>
          </div>

          <div class="pt-4 flex flex-wrap gap-3">
            <a
              href={`/programas/${programa.slug}/dia-0`}
              class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-brand-500/30 transition hover:bg-brand-400"
            >
              <span>Comenzar con el Día 0</span>
              <span>➔</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Learning Path (Ruta de Aprendizaje Día 0 al Día 7) -->
  <section class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-slate-900">Ruta de Aprendizaje Día a Día</h2>
      <p class="text-sm text-slate-500 mt-1">Completa cada sesión en orden para dominar el marco estructural y su implementación práctica.</p>
    </div>

    <ol class="relative border-l-2 border-slate-200 ml-4 space-y-6">
      {programa.dias.map((d) => (
        <li class="relative pl-6 group">
          <!-- Marker dot -->
          <div class="absolute -left-[17px] top-6 flex h-8 w-8 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white ring-4 ring-white group-hover:bg-brand-600 transition">
            {d.dia}
          </div>

          <a
            href={`/programas/${programa.slug}/${d.diaSlug}`}
            class="block rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm transition hover:border-brand-400 hover:shadow-md"
          >
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <span class="inline-block text-xs font-bold uppercase tracking-wider text-brand-600">
                {d.dia === 0 ? 'Onboarding & Marco Estructural' : `Módulo ${d.dia}`}
              </span>
              <span class="text-xs text-slate-400">
                ⏱ {d.duracion || '10 min'}
              </span>
            </div>

            <h3 class="mt-2 text-lg sm:text-xl font-bold text-slate-900 group-hover:text-brand-600 transition">
              {d.titulo}
            </h3>

            {d.descripcion && (
              <p class="mt-2 text-sm text-slate-600 leading-relaxed">
                {d.descripcion}
              </p>
            )}

            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2 text-xs text-slate-500">
                {d.audio && <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-200">🎧 Podcast</span>}
                {d.slidesPdf && <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-200">📊 Slides</span>}
                {d.guiaPdf && <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-200">📑 Workbook</span>}
                {d.flashcardsCount > 0 && <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-200">🎴 Flashcards ({d.flashcardsCount})</span>}
                {d.quizCount > 0 && <span class="bg-slate-50 px-2 py-0.5 rounded border border-slate-200">📝 Quiz ({d.quizCount})</span>}
              </div>

              <span class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 group-hover:translate-x-1 transition-transform">
                Ver lección completa ➔
              </span>
            </div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
