---
import { SITE, CATEGORIAS } from '../config.mjs';
---

<header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-extrabold text-slate-900">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-600 text-white">R</span>
      <span class="hidden sm:inline">{SITE.name}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {CATEGORIAS.slice(0, 5).map((c) => (
        <a
          href={`/categorias/${c.slug}`}
          class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900"
        >
          {c.nombre}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href="/frases"
        class="hidden rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 sm:inline"
      >
        Frases
      </a>
      <a
        href="/resumenes"
        class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-700"
      >
        Ver resúmenes
      </a>
    </div>
  </nav>
</header>
