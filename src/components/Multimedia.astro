---
interface Props {
  youtube?: string;
  spotify?: string;
  audio?: string;
  short?: string;
  titulo?: string;
}
const { youtube, spotify, audio, short, titulo = '' } = Astro.props;

// Acepta un ID o una URL completa de episodio de Spotify y extrae el ID.
let spotifyId = '';
if (spotify) {
  const m = spotify.match(/episode\/([A-Za-z0-9]+)/);
  spotifyId = m ? m[1] : spotify.trim();
}
---

{spotifyId && (
  <div class="mt-8">
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-700">
      🎧 Escucha este resumen (podcast)
    </p>
    <iframe
      class="w-full rounded-2xl"
      style="height:152px"
      src={`https://open.spotify.com/embed/episode/${spotifyId}`}
      title={titulo}
      loading="lazy"
      frameborder="0"
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    ></iframe>
  </div>
)}

{!spotifyId && audio && (
  <div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5">
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-700">
      🎧 Escucha este resumen
    </p>
    <audio controls preload="none" class="w-full">
      <source src={audio} type={audio.endsWith('.mp3') ? 'audio/mpeg' : 'audio/mp4'} />
      Tu navegador no soporta audio.
    </audio>
  </div>
)}

{short && (
  <div class="mt-8">
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-700">
      📱 Video resumen (short)
    </p>
    <div class="mx-auto" style="max-width:360px">
      <div class="relative overflow-hidden rounded-2xl bg-black" style="aspect-ratio:9/16">
        <video
          class="absolute inset-0 h-full w-full object-cover"
          controls
          preload="metadata"
          playsinline
          poster=""
        >
          <source src={short} type="video/mp4" />
          Tu navegador no soporta video.
        </video>
      </div>
    </div>
  </div>
)}

{youtube && (
  <div class="mt-8">
    <p class="mb-3 flex items-center gap-2 text-sm font-semibold text-slate-700">
      ▶️ Míralo en vídeo
    </p>
    <div class="relative aspect-video overflow-hidden rounded-2xl bg-black">
      <iframe
        class="absolute inset-0 h-full w-full"
        src={`https://www.youtube-nocookie.com/embed/${youtube}`}
        title={titulo}
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </div>
)}
