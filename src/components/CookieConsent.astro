---
// Aviso de cookies (informativo). El script de AdSense se carga en el <head>
// (ver SEO.astro). Para el consentimiento de la UE/EEE usa el CMP certificado
// gratuito de Google: AdSense → Privacidad y mensajes. Ver DEPLOY.md.
---

<div id="cookie-banner" class="fixed inset-x-0 bottom-0 z-50 hidden p-4">
  <div class="mx-auto flex max-w-4xl flex-col items-start gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-xl sm:flex-row sm:items-center">
    <p class="flex-1 text-sm text-slate-600">
      Usamos cookies propias y de terceros (incluida la publicidad de Google) para mejorar tu
      experiencia y mostrar anuncios. Consulta nuestra
      <a href="/cookies" class="font-semibold text-brand-600 hover:underline">Política de Cookies</a>.
    </p>
    <div class="flex shrink-0 gap-2">
      <a href="/cookies" class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">
        Más info
      </a>
      <button id="cookie-accept" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">
        Aceptar
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'cookie-consent-v1';
  const banner = document.getElementById('cookie-banner');
  let estado = null;
  try { estado = localStorage.getItem(KEY); } catch (e) {}
  if (!estado) banner?.classList.remove('hidden');
  document.getElementById('cookie-accept')?.addEventListener('click', () => {
    try { localStorage.setItem(KEY, 'accept'); } catch (e) {}
    banner?.classList.add('hidden');
  });
</script>
