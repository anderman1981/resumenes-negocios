---
import { CATEGORIAS } from '../config.mjs';

interface Props {
  entry: any;
}
const { entry } = Astro.props;
const { data, slug } = entry;
const cat = CATEGORIAS.find((c) => c.slug === data.categoria);
---

<a
  href={`/resumenes/${slug}`}
  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
>
  <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-brand-500 to-brand-800">
    {data.portada ? (
      <img src={data.portada} alt={data.libro} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex h-full w-full items-center justify-center p-6 text-center">
        <span class="text-lg font-bold leading-tight text-white/95">{data.libro}</span>
      </div>
    )}
    {cat && (
      <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-brand-700">
        {cat.nombre}
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-brand-600">
      {data.titulo}
    </h3>
    <p class="mt-1 text-sm text-slate-500">de {data.autor}</p>
    <p class="mt-3 line-clamp-3 flex-1 text-sm text-slate-600">{data.descripcion}</p>
    <div class="mt-4 flex items-center gap-3 text-xs text-slate-400">
      <span>⏱ {data.minutosLectura} min</span>
      <span>·</span>
      <span>{data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
    </div>
  </div>
</a>
