---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

<section class="mt-12" data-slug={slug}>
  <h2 class="text-xl font-bold text-slate-900">Comentarios</h2>

  <form id="com-form" class="mt-4 space-y-3">
    <div class="grid gap-3 sm:grid-cols-2">
      <input
        id="com-nombre"
        type="text"
        placeholder="Tu nombre (opcional)"
        maxlength="60"
        class="rounded-xl border border-slate-200 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
      />
    </div>
    <textarea
      id="com-texto"
      required
      rows="3"
      maxlength="1500"
      placeholder="Escribe tu comentario…"
      class="w-full rounded-xl border border-slate-200 px-4 py-2.5 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100"
    ></textarea>
    <button id="com-enviar" type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 font-semibold text-white transition hover:bg-brand-700 disabled:opacity-60">
      Publicar comentario
    </button>
  </form>

  <div id="com-lista" class="mt-8 space-y-4">
    <p class="text-sm text-slate-400">Cargando comentarios…</p>
  </div>
</section>

<script define:vars={{ slug }}>
  const lista = document.getElementById('com-lista');
  const form = document.getElementById('com-form');
  const btn = document.getElementById('com-enviar');

  function fmt(iso) {
    try { return new Date(iso).toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }); }
    catch (e) { return ''; }
  }

  function pintar(items) {
    if (!items || items.length === 0) {
      lista.innerHTML = '<p class="text-sm text-slate-400">Aún no hay comentarios. ¡Sé el primero!</p>';
      return;
    }
    lista.innerHTML = '';
    items.forEach((c) => {
      const div = document.createElement('div');
      div.className = 'rounded-xl border border-slate-100 bg-white p-4';
      const cab = document.createElement('div');
      cab.className = 'flex items-center gap-2 text-sm';
      const nom = document.createElement('span');
      nom.className = 'font-semibold text-slate-800';
      nom.textContent = c.nombre || 'Anónimo';
      const fecha = document.createElement('span');
      fecha.className = 'text-slate-400';
      fecha.textContent = '· ' + fmt(c.fecha);
      cab.appendChild(nom); cab.appendChild(fecha);
      const txt = document.createElement('p');
      txt.className = 'mt-1 whitespace-pre-wrap text-slate-700';
      txt.textContent = c.texto; // textContent evita XSS
      div.appendChild(cab); div.appendChild(txt);
      lista.appendChild(div);
    });
  }

  async function cargar() {
    try {
      const r = await fetch('/api/comentarios?slug=' + encodeURIComponent(slug));
      const data = await r.json();
      pintar(data.comentarios);
    } catch (e) {
      lista.innerHTML = '<p class="text-sm text-slate-400">No se pudieron cargar los comentarios.</p>';
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const nombre = document.getElementById('com-nombre').value.trim();
    const texto = document.getElementById('com-texto').value.trim();
    if (!texto) return;
    btn.disabled = true; btn.textContent = 'Enviando…';
    try {
      const r = await fetch('/api/comentarios', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ slug, nombre, texto }),
      });
      if (r.ok) {
        document.getElementById('com-texto').value = '';
        await cargar();
      }
    } catch (e) {}
    btn.disabled = false; btn.textContent = 'Publicar comentario';
  });

  cargar();
</script>
