---
interface Props {
  slidesUrl?: string;
  slidesTitle?: string;
  slidesDesc?: string;
  guiaUrl?: string;
  guiaTitle?: string;
  guiaDesc?: string;
}

const {
  slidesUrl,
  slidesTitle = 'Presentación de Slides (PDF)',
  slidesDesc = 'Resumen visual de diapositivas y marcos estratégicos de la sesión.',
  guiaUrl,
  guiaTitle = 'Guía Práctica Descargable (PDF)',
  guiaDesc = 'Workbook de aplicación inmediata, matrices de cálculo y rúbricas.',
} = Astro.props;
---

<div class="rounded-2xl border border-slate-200 bg-slate-50/80 p-5 sm:p-6 my-8">
  <div class="flex items-center gap-2 mb-4">
    <span class="text-xl">📥</span>
    <h3 class="text-base sm:text-lg font-bold text-slate-900">
      Materiales y Documentación Oficial
    </h3>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    {slidesUrl && (
      <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="inline-flex items-center gap-1 rounded-md bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-700 border border-amber-200">
              📊 Slides
            </span>
            <span class="text-[11px] font-mono text-slate-400">PDF</span>
          </div>
          <h4 class="font-bold text-slate-900 text-sm sm:text-base">
            {slidesTitle}
          </h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">
            {slidesDesc}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a
            href={slidesUrl}
            download
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition hover:bg-brand-600 hover:shadow"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descargar Slides</span>
          </a>
        </div>
      </div>
    )}

    {guiaUrl && (
      <div class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="inline-flex items-center gap-1 rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 border border-emerald-200">
              📑 Workbook & Guía
            </span>
            <span class="text-[11px] font-mono text-slate-400">PDF</span>
          </div>
          <h4 class="font-bold text-slate-900 text-sm sm:text-base">
            {guiaTitle}
          </h4>
          <p class="mt-1 text-xs text-slate-500 leading-relaxed">
            {guiaDesc}
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100">
          <a
            href={guiaUrl}
            download
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 hover:shadow"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descargar Guía</span>
          </a>
        </div>
      </div>
    )}
  </div>
</div>
