---
import { ADSENSE } from '../config.mjs';

interface Props {
  slot?: keyof typeof ADSENSE.slots;
  format?: string;
  class?: string;
}

const { slot = 'inArticle', format = 'auto', class: className = '' } = Astro.props;
const slotId = ADSENSE.slots[slot];
// Solo renderiza un bloque manual si has creado un "slot" en AdSense.
// Con los Anuncios Automáticos de Google no hace falta: el script del <head>
// coloca los anuncios solo. Si no hay slot, no mostramos nada.
const manual = Boolean(ADSENSE.client && slotId);
---

{manual && (
  <div class={`my-8 ${className}`}>
    <p class="text-center text-xs uppercase tracking-wide text-slate-400 mb-1">Publicidad</p>
    <ins
      class="adsbygoogle block"
      style="display:block"
      data-ad-client={ADSENSE.client}
      data-ad-slot={slotId}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
